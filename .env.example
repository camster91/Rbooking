# Rotman AV Booking - Environment Variables

# Server
PORT=3000
NODE_ENV=development

# ============================================
# EMAIL SETUP - Hostinger Titan Mail
# ============================================
# Titan Mail settings for Hostinger:
# SMTP_HOST: smtp.titan.email
# SMTP_PORT: 465 (SSL) or 587 (TLS)
# SMTP_SECURE: true for 465, false for 587
# SMTP_USERNAME: your Titan email (e.g., requests@rotmanav.ca)
# SMTP_PASSWORD: your Titan email password
# ============================================

SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=requests@rotmanav.ca
SMTP_PASSWORD=your_titan_password_here

# Email Settings
EMAIL_TO=requests@rotmanav.ca

# Set when running behind a reverse proxy (e.g. 1 = one proxy hop) so rate
# limiting sees each user's real IP instead of the proxy's
# TRUST_PROXY=1

# Application URL
BASE_URL=http://localhost:3000

# Logins - both passwords are required in production; never deploy the defaults
# Shared login for the booking form
AUTH_USER=admin
AUTH_PASS=change_me
# AV staff login for /admin and uploaded files (use a different username)
ADMIN_USER=av-admin
ADMIN_PASS=change_me_too

# Where the bookings database lives (keep this on a persistent disk)
# DATA_DIR=./data

# Delete uploaded files this many days after the event
# UPLOAD_RETENTION_DAYS=90